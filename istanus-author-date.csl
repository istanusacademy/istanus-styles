<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" page-range-format="minimal" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="en-US">
  <info>
    <title>Istanus (author-date)</title>
    <id>http://www.zotero.org/styles/istanus</id>
    <link href="http://www.zotero.org/styles/istanus" rel="self"/>
    <link href="https://istanus.com/istanusjabs/about/submissions" rel="documentation"/>
    <category citation-format="author-date"/>
    <category field="biology"/>
    <category field="medicine"/>
    <category field="science"/>
    <summary>Istanus author-date style. The reference list is identical to the Istanus Vancouver style (full author names without periods, no leading number, DOI or URL appended without trailing period, italic journal/book titles). Only the in-text citation changes to (Author, Year); three or more authors are shortened with "et al." in-text.</summary>
    <updated>2026-07-10T09:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <!-- BIBLIOGRAPHY authors: identical to the Vancouver style -->
  <macro name="author">
    <names variable="author">
      <name initialize-with="" delimiter=", " delimiter-precedes-last="always" name-as-sort-order="all" sort-separator=" "/>
      <label form="long" prefix=", "/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
      </substitute>
    </names>
  </macro>

  <!-- IN-TEXT authors: surnames only, for the (Author, Year) citation and sorting -->
  <macro name="author-short">
    <names variable="author">
      <name form="short" and="text" delimiter=", " delimiter-precedes-last="never"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="year-date">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>

  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" disambiguate-add-names="false" collapse="year">
    <sort>
      <key macro="author-short"/>
      <key variable="issued"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-short"/>
        <text macro="year-date"/>
      </group>
    </layout>
  </citation>

  <bibliography entry-spacing="0">
    <sort>
      <key macro="author-short"/>
      <key variable="issued"/>
    </sort>
    <layout>
      <text macro="author" suffix=". "/>
      <choose>

        <!-- Books and similar -->
        <if type="bill book graphic legal_case legislation motion_picture report song" match="any">
          <group delimiter=". ">
            <text variable="title" font-style="italic"/>
            <text variable="volume" prefix="vol. "/>
            <group delimiter=": ">
              <text variable="publisher-place"/>
              <text variable="publisher"/>
            </group>
            <text macro="year-date"/>
          </group>
        </if>

        <!-- Chapter / Paper-Conference with editors and container-title -->
        <else-if type="chapter paper-conference" match="any">
          <group delimiter=". ">
            <text variable="title"/>
            <group>
              <text term="in" text-case="capitalize-first" suffix=": "/>
              <names variable="editor">
                <name initialize-with="" delimiter=", " delimiter-precedes-last="always"/>
                <label form="short" prefix=", " text-case="lowercase"/>
              </names>
            </group>
            <text variable="container-title" font-style="italic"/>
            <group delimiter=": ">
              <text variable="publisher-place"/>
              <text variable="publisher"/>
            </group>
            <text macro="year-date"/>
            <group delimiter=" ">
              <label variable="page" form="short" plural="never"/>
              <text variable="page"/>
            </group>
          </group>
        </else-if>

        <!-- Journal articles and other -->
        <else>
          <group delimiter=":">
            <group delimiter=" ">
              <group delimiter=". ">
                <text variable="title"/>
                <text variable="container-title" form="short" text-case="title" strip-periods="true" font-style="italic"/>
              </group>
              <group delimiter=";">
                <text macro="year-date"/>
                <group delimiter="">
                  <text variable="volume"/>
                  <text variable="issue" prefix="(" suffix=")"/>
                </group>
              </group>
            </group>
            <text variable="page" form="short"/>
          </group>
        </else>
      </choose>

      <!-- DOI or URL -->
      <choose>
        <if variable="DOI">
          <group delimiter="">
            <text value=". https://doi.org/"/>
            <text variable="DOI"/>
          </group>
        </if>
        <else-if variable="URL">
          <group delimiter="">
            <text value=". "/>
            <text variable="URL"/>
          </group>
        </else-if>
      </choose>
    </layout>
  </bibliography>
</style>
