<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" page-range-format="minimal" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="en-US">
  <info>
    <title>Istanus (author-date)</title>
    <id>http://www.zotero.org/styles/istanus</id>
    <link href="http://www.zotero.org/styles/istanus" rel="self"/>
    <link href="https://istanus.com/istanusjabs/about/submissions" rel="documentation"/>
    <category citation-format="author-date"/>
    <category field="biology"/>
    <category field="medicine"/>
    <category field="science"/>
    <summary>Author-date (Harvard-based) citation style for Istanus publications (journals, books and congresses). Abbreviated journal titles in italics, no quotation marks on article titles, DOI or URL appended without a trailing period, minimal page ranges. In-text: (Author, Year); two authors joined with "and"; three or more shortened with "et al.".</summary>
    <updated>2026-07-10T08:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <!-- Full author list for the bibliography: Surname, Initials. -->
  <macro name="author">
    <names variable="author">
      <name and="text" initialize-with="." delimiter=", " delimiter-precedes-last="never" name-as-sort-order="all" sort-separator=", "/>
      <label form="short" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
      </substitute>
    </names>
  </macro>

  <!-- Surnames only, for the in-text citation and for sorting -->
  <macro name="author-short">
    <names variable="author">
      <name form="short" and="text" delimiter=", " delimiter-precedes-last="never"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="year-date">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>

  <macro name="year-date-bib">
    <group prefix="(" suffix=")">
      <text macro="year-date"/>
    </group>
  </macro>

  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" disambiguate-add-names="false" collapse="year">
    <sort>
      <key macro="author-short"/>
      <key variable="issued"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-short"/>
        <text macro="year-date"/>
      </group>
    </layout>
  </citation>

  <bibliography entry-spacing="0" hanging-indent="true">
    <sort>
      <key macro="author-short"/>
      <key variable="issued"/>
    </sort>
    <layout>
      <group delimiter=" ">
        <text macro="author"/>
        <text macro="year-date-bib"/>
      </group>
      <choose>

        <!-- Books and similar -->
        <if type="bill book graphic legal_case legislation motion_picture report song" match="any">
          <group prefix=" " delimiter=". ">
            <text variable="title" font-style="italic"/>
            <text variable="volume" prefix="vol. "/>
            <group delimiter=": ">
              <text variable="publisher-place"/>
              <text variable="publisher"/>
            </group>
          </group>
        </if>

        <!-- Chapter / conference paper with editors and container-title -->
        <else-if type="chapter paper-conference" match="any">
          <group prefix=" " delimiter=". ">
            <text variable="title"/>
            <group>
              <text term="in" text-case="capitalize-first" suffix=": "/>
              <names variable="editor">
                <name and="text" initialize-with="." delimiter=", " delimiter-precedes-last="never" name-as-sort-order="all" sort-separator=", "/>
                <label form="short" prefix=" (" suffix=")"/>
              </names>
            </group>
            <text variable="container-title" font-style="italic"/>
            <group delimiter=": ">
              <text variable="publisher-place"/>
              <text variable="publisher"/>
            </group>
            <group delimiter=" ">
              <label variable="page" form="short" plural="never"/>
              <text variable="page"/>
            </group>
          </group>
        </else-if>

        <!-- Journal articles and everything else -->
        <else>
          <group prefix=" " delimiter=". ">
            <text variable="title"/>
            <group delimiter=", ">
              <text variable="container-title" form="short" text-case="title" strip-periods="true" font-style="italic"/>
              <group delimiter="">
                <text variable="volume"/>
                <text variable="issue" prefix="(" suffix=")"/>
              </group>
              <text variable="page"/>
            </group>
          </group>
        </else>
      </choose>

      <!-- DOI or URL, no trailing period -->
      <choose>
        <if variable="DOI">
          <group delimiter="">
            <text value=". https://doi.org/"/>
            <text variable="DOI"/>
          </group>
        </if>
        <else-if variable="URL">
          <group delimiter="">
            <text value=". "/>
            <text variable="URL"/>
          </group>
        </else-if>
      </choose>
    </layout>
  </bibliography>
</style>
